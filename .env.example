# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# TRENDSCAN_GEMINI_MODEL=gemini-3.5-flash-lite
# TRENDSCAN_MAX_ANALYSES_PER_SCAN=30
# TRENDSCAN_SECONDS_BETWEEN_CALLS=12

# Full text of papers and reports (PDF)
# TRENDSCAN_MAX_DOC_CHARS=60000            # text sent to Gemini per document
# TRENDSCAN_MAX_FULLTEXT_PER_SCAN=10       # full-text analyses and PDF downloads per scan
# TRENDSCAN_MAX_PDF_MB=25
# TRENDSCAN_PDF_TIMEOUT_SECONDS=120        # time limit for one PDF download
# TRENDSCAN_MAX_DOC_SECONDS_PER_SCAN=300   # time budget for all PDF downloads in one scan

# Version tracking
# TRENDSCAN_REVISION_CHECK_DAYS=90         # check items first seen in the last N days for new versions

# Scheduled scans (python -m trendscan scan --scheduled) run unattended and may wait longer for PDFs
# TRENDSCAN_SCHEDULED_PDF_TIMEOUT_SECONDS=300
# TRENDSCAN_SCHEDULED_DOC_SECONDS_PER_SCAN=1200

# Email digest after each scheduled scan. "test" (default) saves it to data/digests/ and sends nothing.
# TRENDSCAN_EMAIL_MODE=test                 # test | smtp
# TRENDSCAN_EMAIL_TO=you@example.org        # comma-separated
# TRENDSCAN_EMAIL_FROM=TrendScan <trendscan@example.org>
# TRENDSCAN_SMTP_HOST=
# TRENDSCAN_SMTP_PORT=587                   # STARTTLS is always used
# TRENDSCAN_SMTP_USER=
# TRENDSCAN_SMTP_PASSWORD=                  # kept out of logs, like the API key
